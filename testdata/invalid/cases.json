[
  {
    "why": "passed outcome carrying a failure step, the anti-pattern the sum type exists to forbid",
    "mutate": {
      "outcome": {
        "kind": "passed",
        "atStep": "close",
        "message": "boom"
      }
    }
  },
  {
    "why": "failed outcome with no step named, which would make a red cell unattributable",
    "mutate": {
      "outcome": {
        "kind": "failed"
      }
    }
  },
  {
    "why": "failed outcome with no message, losing akt's verbatim error",
    "mutate": {
      "outcome": {
        "kind": "failed",
        "atStep": "send-manifest"
      }
    }
  },
  {
    "why": "outcome kind outside the three the site knows how to render",
    "mutate": {
      "outcome": {
        "kind": "degraded",
        "atStep": "close"
      }
    }
  },
  {
    "why": "close recorded as a lifecycle step, which would force the timeline to lie: close runs even when the lifecycle never began, so it cannot be 'skipped after the failure'",
